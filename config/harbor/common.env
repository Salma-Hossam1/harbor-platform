# External URL
HARBOR_URL=http://localhost

# Database
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=harbor
POSTGRES_USER=harbor
POSTGRES_PASSWORD=harborpass

# Redis
REDIS_HOST=redis
REDIS_PORT=6379

# Registry
REGISTRY_HOST=registry
REGISTRY_PORT=5000

# Storage
REGISTRY_STORAGE=/storage

# Secret keys
CORE_SECRET=replace-me
JOBSERVICE_SECRET=replace-me
