KAFKA_BROKERS=kafka:9092
KAFKA_TOPIC=harbor-events
KAFKA_GROUP_ID=image-signer

HARBOR_REGISTRY=harbor.local
HARBOR_USERNAME=<Secret>
HARBOR_PASSWORD=<Secret>

COSIGN_PRIVATE_KEY=/etc/cosign/cosign.key
COSIGN_PASSWORD=<Secret>

COSIGN_INSECURE_IGNORE_TLOG=true


// because we're now using real HTTPS with the trusted CA.
COSIGN_ALLOW_HTTP=false
COSIGN_ALLOW_INSECURE_REGISTRY=false